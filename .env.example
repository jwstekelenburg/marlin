DATABASE_URL=postgres://marlin:marlin@localhost:5433/marlin
API_PORT=3000

# LM worker profile from data/worker-profiles.json (url / model / concurrency).
# CLI overrides: npm run worker -- vast
WORKER_PROFILE=local
# Optional. Override path to the profiles file.
# WORKER_PROFILES_FILE=C:\path\to\worker-profiles.json

WORKER_POLL_MS=200

# Page text char cap used by fetcher-side helpers when no worker profile is loaded.
# Worker profiles set their own textChars.
LM_TEXT_CHARS=4000

FETCH_CONCURRENCY=16
FETCH_POLL_MS=500
# Pause fetch when this many rows are waiting on / in the LM worker.
FETCH_MAX_READY=500
# Max non-apex hosts stored per ICANN eTLD+1 (tumblr.com, example.co.uk). Overflow is not queued.
MAX_SUBDOMAINS_PER_APEX=100

# Optional. If set, replaces the default English TLD list (com,org,net,uk,us,...).
# TLD_WHITELIST=com,org,net,edu,gov,io,ai,dev,app,uk,us,au,nz,ca,ie

# Optional. Override path to category crawl-priority weights (default: data/category-priority.txt).
# CATEGORY_PRIORITY_FILE=C:\path\to\category-priority.txt

FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=1000000
FETCH_DELAY_MS=200
FETCH_USER_AGENT=MarlinPersonalIndex/0.1

SPIDER_SEEDS=https://example.com
SPIDER_MAX_DEPTH=1
SPIDER_MAX_HOSTS=50
SPIDER_CONCURRENCY=4
SPIDER_DELAY_MS=500
SPIDER_FROM_QUEUE=false
