DATABASE_URL=postgres://marlin:marlin@localhost:5433/marlin
API_PORT=3000
# Bind address. Default 127.0.0.1 (loopback). Compose sets 0.0.0.0.
# API_HOST=127.0.0.1
# Comma-separated browser Origins allowed by CORS (Vite + Compose web defaults if unset).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LM connection from data/lm-profiles.json; worker runtime from data/worker-profiles.json.
# CLI overrides: npm run worker -- vast-g4-4b-1
WORKER_PROFILE=local
# Optional. Override paths to the profile files.
# LM_PROFILES_FILE=C:\path\to\lm-profiles.json
# WORKER_PROFILES_FILE=C:\path\to\worker-profiles.json

WORKER_POLL_MS=200
# Soft-start LM concurrency (avoids vLLM OOM on a cold prefill burst). Set RAMP_MS=0 to disable.
# WORKER_RAMP_START=8
# WORKER_RAMP_STEP=8
# WORKER_RAMP_MS=30000
# Steward spiral reviewer (same WORKER_PROFILE). Poll when idle; batch size per pass.
# STEWARD_POLL_MS=60000
# STEWARD_BATCH=10
# STEWARD_SAMPLE=5
# STEWARD_SAMPLE_EXTRA=5

# Page text char cap used by fetcher-side helpers when no worker profile is loaded.
# Worker profiles set their own textChars.
LM_TEXT_CHARS=4000

FETCH_CONCURRENCY=16
FETCH_POLL_MS=500
# Pause fetch when this many rows are waiting on / in the LM worker.
FETCH_MAX_READY=500
# Max non-apex hosts stored per ICANN eTLD+1 (tumblr.com, example.co.uk). Overflow is not queued.
MAX_SUBDOMAINS_PER_APEX=100

# Policy files live under data/ (see data/README.md). Optional path overrides:
# TLD_FILE=C:\path\to\tlds.txt
# LANGUAGE_PRIORITY_FILE=C:\path\to\language-priority.txt
# CATEGORY_PRIORITY_FILE=C:\path\to\category-priority.txt
# BLOCKED_APEX_FILE=C:\path\to\blocked-apex.txt
# ALLOWED_APEX_FILE=C:\path\to\allowed-apex.txt
# LABEL_ALIASES_FILE=C:\path\to\label-aliases.txt
# Advanced: replace data/tlds.txt entirely for this process (comma/space separated).
# TLD_WHITELIST=com,org,net,edu,gov,io,ai,dev,app,uk,us,au,nz,ca,ie

FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=1000000
FETCH_DELAY_MS=200
FETCH_USER_AGENT=MarlinPersonalIndex/0.1

# Optional BFS link spider (not required for a normal crawl).
# Prefer: npm run ingest -- <file> → fetcher → worker.
# Primary link growth is LM outbound enqueue after catalog. Spider only expands
# from SPIDER_SEEDS (or SPIDER_FROM_QUEUE) into pending for the fetcher.
# Keep depth/hosts small until you trust it.
SPIDER_SEEDS=https://example.com
SPIDER_MAX_DEPTH=1
SPIDER_MAX_HOSTS=50
SPIDER_CONCURRENCY=4
SPIDER_DELAY_MS=500
SPIDER_FROM_QUEUE=false
