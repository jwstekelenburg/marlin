{
  "name": "marlin",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @marlin/api\" \"npm run dev -w @marlin/web\"",
    "dev:fetcher": "npm run dev -w @marlin/fetcher",
    "dev:worker": "npm run dev -w @marlin/worker --",
    "dev:spider": "npm run dev -w @marlin/spider",
    "dev:steward": "npm run dev -w @marlin/steward --",
    "dev:tools": "concurrently -n api,web,fetch,lm -c cyan,magenta,green,yellow \"npm run dev -w @marlin/api\" \"npm run dev -w @marlin/web\" \"npm run dev -w @marlin/fetcher\" \"npm run dev -w @marlin/worker\"",
    "ingest": "npm run ingest -w @marlin/spider --",
    "spider": "npm run start -w @marlin/spider",
    "fetcher": "npm run start -w @marlin/fetcher",
    "worker": "npm run start -w @marlin/worker --",
    "steward": "npm run start -w @marlin/steward --",
    "probe": "npm run probe -w @marlin/worker --",
    "compare-models": "npm run compare-models -w @marlin/worker --",
    "requeue": "npm run requeue -w @marlin/db --",
    "flush-queue": "npm run flush-queue -w @marlin/db",
    "merge-labels": "npm run merge-labels -w @marlin/db --",
    "db:migrate": "npm run migrate -w @marlin/db",
    "db:generate": "npm run generate -w @marlin/db",
    "db:studio": "npm run studio -w @marlin/db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "dependencies": {
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
